# Server
PORT=4000
# Comma-separated allowed origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Seed admin credentials (used by `npm run seed`)
ADMIN_EMAIL=admin@cob.com
ADMIN_PASSWORD=admin1234
ADMIN_NAME=COB Admin

EDITOR_EMAIL=editor@cob.com
EDITOR_PASSWORD=editor1234
EDITOR_NAME=COB Editor
